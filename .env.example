# NecroCD environment variables. Copy to .env (backend) / frontend/.env.local (frontend).
# Never commit real secrets.

# --- Backend (FastAPI) ---
# Optional. Comma-separated allowed browser origins. Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Optional. Local git repo listed by GET /api/graves. Default: the NecroCD checkout itself.
NECROCD_REPO=

# --- MCP server (mcp/server.py) ---
# Optional but recommended. Roots the MCP git tools may touch, separated by the OS path
# separator (":" on Linux/macOS, ";" on Windows). Defaults to the NecroCD checkout.
NECROCD_ALLOWED_ROOTS=.

# --- Git hooks (.kiro/hooks) ---
# Optional. Set to 1 to make the pre-commit hook block commits on high severity findings.
NECROCD_STRICT=0

# --- Supabase persistence ---
# Read by backend/db/supabase_client.py. If either is unset, persistence is a no-op (warning logged).
# Apply supabase/migrations/0001_necrocd_schema.sql first. SUPABASE_SERVICE_KEY is a secret, server side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Frontend (Next.js) ---
# Required for production builds (inlined at build time). Default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
